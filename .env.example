NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://presence_user:presence_password@localhost:5432/presence_db
REDIS_URL=redis://localhost:6379

GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Browser redirect flow only; leave blank for the Android-only flow
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Extra ID-token audiences, comma separated (e.g. the Android/installed OAuth client ID).
# Installed clients have no client secret, so they can only use the idToken flow.
GOOGLE_EXTRA_CLIENT_IDS=

ACCESS_TOKEN_SECRET=development_access_token_secret_min_32_characters_long
REFRESH_TOKEN_SECRET=development_refresh_token_secret_min_32_characters_long

# SFace cosine-similarity threshold (OpenCV reference: 0.363)
FACE_MATCH_THRESHOLD=0.363
# Minimum normalised Laplacian texture score for passive liveness
FACE_PASSIVE_LIVENESS_MIN=0.2

# Cloudinary (avatar/report uploads). Required; never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional; OTP mails are skipped when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Presence App <noreply@presence.app>
